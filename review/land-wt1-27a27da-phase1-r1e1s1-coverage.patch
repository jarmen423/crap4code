@@ -0,0 +1,68 @@
+"""Manual simulation script for coverage command failure diagnostics (S1/S2)."""
+
+import tempfile
+import os
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+
+print("=== MANUAL CLI COVERAGE-FAILURE SIMULATION (phase1-s1) ===")
+with tempfile.TemporaryDirectory() as td:
+    root = Path(td)
+    srcd = root / "src"
+    srcd.mkdir()
+    (srcd / "sample.py").write_text("def foo(x):\n    return 1 if x else 0\n", encoding="utf-8")
+
+    cfg = root / ".crap4code.toml"
+    cfg_text = """[scan]
+default_paths = ["src"]
+threshold = 5.0
+format = "json"
+
+[python]
+enabled = true
+paths = ["src"]
+coverage_command = 'python -c "import sys; sys.exit(77)"'
+
+[javascript]
+enabled = false
+[typescript]
+enabled = false
+[rust]
+enabled = false
+"""
+    cfg.write_text(cfg_text, encoding="utf-8")
+
+    env = os.environ.copy()
+    our_src = str(Path.cwd() / "src")
+    env["PYTHONPATH"] = our_src
+
+    cmd = [sys.executable, "-m", "crap4code.main", "scan", "--lang", "python"]
+    proc = subprocess.run(cmd, cwd=root, capture_output=True, text=True, env=env)
+
+    print("returncode from crap4code:", proc.returncode)
+    err = proc.stderr or ""
+    print("--- STDERR (first 2500 chars) ---")
+    print(err[:2500])
+
+    checks = [
+        ("diagnostics prefix", "--- coverage command diagnostics" in err),
+        ("platform shell mentioned", "Platform shell:" in err),
+        ("ComSpec present", "ComSpec=" in err),
+        ("exact command echoed", "Command:" in err and "sys.exit(77)" in err),
+        ("cwd shown", "cwd:" in err),
+        ("returncode shown", "returncode:" in err),
+        ("actionable hint present", "Actionable hint" in err or "ComSpec=cmd.exe" in err),
+        ("failure for language", "Coverage command failed for python" in err),
+    ]
+    all_ok = True
+    for name, ok in checks:
+        status = "PASS" if ok else "FAIL"
+        if not ok:
+            all_ok = False
+        print(f"  CHECK {name}: {status}")
+    print("OVERALL MANUAL SIM:", "ALL CHECKS PASSED" if all_ok else "SOME CHECKS FAILED")
+    if not all_ok:
+        sys.exit(1)
+print("=== simulation complete ===")
