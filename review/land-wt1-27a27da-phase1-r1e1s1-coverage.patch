+"""One-shot precise edit script for cli.py changes (R1/E1/S1 + warnings)."""
+
+from pathlib import Path
+
+path = Path("src/crap4code/cli.py")
+content = path.read_text(encoding="utf-8")
+
+# 1. Update the coverage_for invocation to pass the warnings collector.
+# This lets case-insensitive matches (and future ones) be recorded.
+old_cf = '        state, percent = database.coverage_for(row.file_path, row.start_line, row.end_line)'
+new_cf = '        state, percent = database.coverage_for(row.file_path, row.start_line, row.end_line, warnings)'
+if old_cf in content:
+    content = content.replace(old_cf, new_cf)
+    print("Updated coverage_for call site to forward warnings list.")
+else:
+    print("WARNING: exact coverage_for call not found; manual check needed.")
+    # try a tolerant match
+    if "coverage_for(row.file_path, row.start_line, row.end_line)" in content and "warnings" not in content.split("coverage_for(row.file_path, row.start_line, row.end_line)")[1].split("\n")[0]:
+        content = content.replace(
+            "database.coverage_for(row.file_path, row.start_line, row.end_line)",
+            "database.coverage_for(row.file_path, row.start_line, row.end_line, warnings)"
+        )
+        print("Applied tolerant coverage_for update.")
+
+# 2. Update the cleanup call to capture + extend warnings (E1 + phase2).
+old_cleanup = "            cleanup_artifacts(root, settings.stale_artifacts)"
+new_cleanup = """            # Hardenened cleanup (phase1-e1) now returns warnings instead of
+            # potentially raising. Propagate them so they appear in ScanReport
+            # (via build_report) and are printed after the report (phase2).
+            cleanup_warnings = cleanup_artifacts(root, settings.stale_artifacts)
+            warnings.extend(cleanup_warnings)"""
+if old_cleanup in content:
+    content = content.replace(old_cleanup, new_cleanup)
+    print("Updated cleanup call to capture and extend warnings.")
+else:
+    print("WARNING: cleanup call site string not matched exactly.")
+
+# 3. Improve the failure printing path with prefixes and actionable Windows help (S1/S2).
+# We replace a larger chunk for context.
+old_fail = """            if not success:
+                if detail:
+                    print(detail, file=sys.stderr)
+                print(
+                    f"Coverage command failed for {language}: {settings.coverage_command}",
+                    file=sys.stderr,
+                )
+                return 1"""
+
+new_fail = """            if not success:
+                if detail:
+                    # detail from run_coverage_command now contains the rich
+                    # diagnostics block (platform shell/ComSpec, exact command,
+                    # cwd, returncode). Prefix it for the user (phase1-s1).
+                    print("--- coverage command diagnostics (see plan S1/S2) ---", file=sys.stderr)
+                    print(detail, file=sys.stderr)
+                print(
+                    f"Coverage command failed for {language}: {settings.coverage_command}",
+                    file=sys.stderr,
+                )
+                # Make it actionable especially for Windows users who may be
+                # surprised that their pwsh session still results in cmd.exe.
+                print(
+                    "Actionable hint: coverage commands run via shell=True under the "
+                    "platform's default shell (ComSpec=cmd.exe on Windows, $SHELL on POSIX). "
+                    "Use python -m forms for portability, or wrap with "
+                    "pwsh -Command '...' when you need pwsh syntax. "
+                    "Diagnostics above include the exact string that was executed.",
+                    file=sys.stderr,
+                )
+                return 1"""
+
+if old_fail in content:
+    content = content.replace(old_fail, new_fail)
+    print("Updated failure handling block with prefixed diagnostics + actionable hint.")
+else:
+    print("WARNING: old_fail block not matched; attempting looser patch for failure prints.")
+    # looser attempts
+    content = content.replace(
+        "if detail:\n                    print(detail, file=sys.stderr)",
+        "if detail:\n                    print(\"--- coverage command diagnostics (see plan S1/S2) ---\", file=sys.stderr)\n                    print(detail, file=sys.stderr)"
+    )
+    if 'print(\n                    f"Coverage command failed for {language}: {settings.coverage_command}",' in content:
+        content = content.replace(
+            'print(\n                    f"Coverage command failed for {language}: {settings.coverage_command}",\n                    file=sys.stderr,\n                )',
+            'print(\n                    f"Coverage command failed for {language}: {settings.coverage_command}",\n                    file=sys.stderr,\n                )\n                print(\n                    "Actionable hint: coverage commands run via shell=True under the platform default shell. See diagnostics and plan S1/S2.",\n                    file=sys.stderr,\n                )'
+        )
+
+path.write_text(content, encoding="utf-8")
+print("cli.py written. Verifying key strings now present...")
+content2 = path.read_text(encoding="utf-8")
+print("  coverage_for now passes warnings?", ", warnings)" in content2.split("coverage_for")[1].split(")")[0] if "coverage_for" in content2 else False)
+print("  cleanup_warnings captured?", "cleanup_warnings = cleanup_artifacts" in content2)
+print("  diagnostics prefix present?", "--- coverage command diagnostics" in content2)
+print("Done.")
