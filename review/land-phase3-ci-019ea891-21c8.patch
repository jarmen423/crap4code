+        if: matrix.os == 'windows-latest'
+        run: python -m pytest -q -k "test_changed_flag_in_non_git_dir_emits_warning" --tb=line
+
+  minimal-install-verify:
+    # Lightweight job to exercise lazy loading + case behaviors under simulated
+    # minimal/python-only install (uninstall other grammars post full install).
+    # Runs the exact verification commands from the phase3-ci / Dev4 plan section.
+    # Only needs one py version; exercises real missing grammars for python-only.
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.13"
+
+      - name: Install project (full)
+        run: python -m pip install --upgrade pip && python -m pip install -e .[dev]
+
+      - name: Simulate minimal/python-only install (uninstall non-python grammars)
+        # tree-sitter core stays; python analyzer uses stdlib ast only (no grammar pkg)
+        run: python -m pip uninstall -y tree-sitter-javascript tree-sitter-typescript tree-sitter-rust || echo "uninstall step completed"
+
+      - name: Verify only python language available via registry (lazy load)
+        run: python -c "from crap4code.languages import get_language_registry; print(sorted(get_language_registry().keys()))"
+
+      - name: Verify python scan works + --lang rust fails gracefully (real minimal)
+        run: |
+          python - << 'PYEOF'
+import contextlib
+import io
+import os
+import tempfile
+from pathlib import Path
+from crap4code.cli import main
+from crap4code.languages import get_language_registry
+
+print("=== REGISTRY UNDER MINIMAL ===")
+langs = sorted(get_language_registry().keys())
+print(langs)
+assert langs == ["python"], langs
+print("REGISTRY_OK")
+
+print("=== GRACEFUL --lang rust FAIL (real missing, no traceback) ===")
+stderr = io.StringIO()
+with contextlib.redirect_stderr(stderr):
+    code = main(["scan", "--lang", "rust"])
+err = stderr.getvalue()
+print("code:", code)
+print("msg excerpt:", err[:200] if err else "(no stderr)")
+assert code == 1
+assert "Rust support requires" in err
+assert "tree-sitter-rust" in err
+print("GRACEFUL_RUST_OK")
+
+print("=== FULL PYTHON SCAN WORKS (actual .py file + config, lazy path) ===")
+with tempfile.TemporaryDirectory() as td:
+    root = Path(td)
+    (root / "sample.py").write_text(
+        "def foo(flag):\n    if flag:\n        return 1\n    return 0\n", encoding="utf-8"
+    )
+    # minimal config to enable python paths so scan actually processes the file
+    # (without config, defaults may yield 'No matching source files found' even if .py present)
+    (root / ".crap4code.toml").write_text(
+        "[scan]\ndefault_paths = [\".\"]\n\n[python]\nenabled = true\npaths = [\".\"]\n",
+        encoding="utf-8"
+    )
+    old = os.getcwd()
+    os.chdir(root)
+    try:
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            c2 = main(["scan", "--lang", "python", "--report-only"])
+        outv = out.getvalue()
+        print("scan_code:", c2)
+        print("scan_has_foo:", "foo" in outv)
+        assert c2 in (0, 2)
+        assert "foo" in outv, outv[:300]
+    finally:
+        os.chdir(old)
+print("PYTHON_SCAN_OK_UNDER_MINIMAL")
+print("MINIMAL_VERIFY_COMPLETE")
+PYEOF
+
+      - name: Run targeted tests safe under minimal (case + no_files + unavailable)
+        run: python -m pytest -q -k "case_insensitive_fallback or no_files_found_returns_0 or unavailable_lang_returns_nonzero" --tb=no
+
   package:
     runs-on: ubuntu-latest
     steps:
       - name: Check out repository
         uses: actions/checkout@v4
