+    def test_case_mismatch_coverage_still_measured(self) -> None:
+        """Windows / case-insensitive FS case-mismatch robustness (R1 + phase1-tests).
+
+        Scenario protected:
+        - On Windows (and some macOS volumes) the on-disk source tree may be
+          walked with one casing (e.g. "Src/CamelCase.py" because a directory
+          was created that way or the user's checkout preserved it).
+        - Coverage tools / lcov / coverage.xml often canonicalize or record
+          filenames using a different casing (commonly all lower, or the
+          casing the collector saw).
+        - Before the casefold logic in CoverageDatabase.coverage_for, this
+          produced silent "indeterminate" even though the lines were covered.
+          That violates the core promise: "missing coverage must stay
+          indeterminate; never invent a CRAP score" ΓÇö but we *should* use
+          measured data when we can deterministically locate it.
+
+        The test creates a report that records "src/camelcase.py" (lower) while
+        we query using "Src/CamelCase.py" (mixed). After the robustness change
+        we expect "measured" + correct percentage, and the casefold_matches
+        list is populated for warning emission in the CLI.
+
+        This test is written to be fully deterministic on both Windows and
+        POSIX (the fallback is now unconditional on exact miss).
+        """
+        with tempfile.TemporaryDirectory() as tmpdir:
+            root = Path(tmpdir)
+            report = root / "coverage.xml"
+            # Report records a lower-cased / differently-cased path (common in practice).
+            report.write_text(
+                textwrap.dedent(
+                    """\
+                    <?xml version="1.0" ?>
+                    <coverage>
+                      <packages>
+                        <package name="Src">
+                          <classes>
+                            <class name="CamelCase" filename="src/camelcase.py">
+                              <lines>
+                                <line number="10" hits="1"/>
+                                <line number="11" hits="1"/>
+                                <line number="12" hits="0"/>
+                              </lines>
+                            </class>
+                          </classes>
+                        </package>
+                      </packages>
+                    </coverage>
+                    """
+                ),
+                encoding="utf-8",
+            )
+
+            database = load_coverage_database(root=root, report_path="coverage.xml", report_format="coverage.py-xml")
+
+            # The "source" side (what an analyzer row would carry) uses the
+            # casing from the actual file on disk / FS walk.
+            state, percent = database.coverage_for("Src/CamelCase.py", 10, 12)
+
+        self.assertIsNotNone(database)
+        self.assertEqual(state, "measured")
+        # Use AlmostEqual to avoid platform float repr differences for 66.6...
+        self.assertAlmostEqual(percent, 200.0 / 3.0, places=10)
+
+        # The casefold logic recorded the mismatch for later warning.
+        self.assertIn("Src/CamelCase.py", getattr(database, "casefold_matches", []))
+
 
